<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="kineticwe.kwe"/>
  <group name="Tiling">
    <entry name="enabled" key="Enabled" type="Bool">
      <label>Whether native tiling is enabled</label>
      <default>true</default>
    </entry>
    <entry name="defaultLayout" key="DefaultLayout" type="String">
      <label>Default layout used for new (output, desktop) pairs that do not have a per-monitor override. One of "MasterStack", "Stacked", "CenterTile", "Columns", "Monocle", "AutoGrid", or "Emerge".</label>
      <default>MasterStack</default>
    </entry>
    <entry name="enabledLayouts" key="EnabledLayouts" type="StringList">
      <label>Layouts the user wants available for cycleLayout() and setLayout(). The list order also determines the cycle order. Options: MasterStack, Stacked, CenterTile, Columns, Monocle, AutoGrid, Emerge.</label>
      <default code="true">QStringList{QStringLiteral("MasterStack"), QStringLiteral("Stacked"), QStringLiteral("CenterTile"), QStringLiteral("Columns"), QStringLiteral("Monocle"), QStringLiteral("AutoGrid"), QStringLiteral("Emerge")}</default>
    </entry>
    <entry name="gapLeft" key="GapLeft" type="Int">
      <label>Gap between the left screen edge and tiles</label>
      <default>10</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <entry name="gapRight" key="GapRight" type="Int">
      <label>Gap between the right screen edge and tiles</label>
      <default>10</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <entry name="gapTop" key="GapTop" type="Int">
      <label>Gap between the top screen edge and tiles</label>
      <default>10</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <entry name="gapBottom" key="GapBottom" type="Int">
      <label>Gap between the bottom screen edge and tiles</label>
      <default>10</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <entry name="gapBetween" key="GapBetween" type="Int">
      <label>Gap between adjacent tiles</label>
      <default>10</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <entry name="tilingBorderMode" key="TilingBorderMode" type="Enum">
      <label>Border display mode for windows</label>
      <choices>
        <choice name="None"/>
        <choice name="AllTiled"/>
        <choice name="ActiveOnly"/>
        <choice name="AllWindows"/>
      </choices>
      <default>None</default>
    </entry>
    <entry name="tilingBorderThickness" key="TilingBorderThickness" type="Int">
      <label>Thickness of the tiling border</label>
      <default>2</default>
      <min>0</min>
      <max>20</max>
    </entry>
    <entry name="tilingBorderColorSourceActive" key="TilingBorderColorSourceActive" type="Enum">
      <label>Source for the active border color</label>
      <choices>
        <choice name="Custom"/>
        <choice name="SystemAccent"/>
      </choices>
      <default>SystemAccent</default>
    </entry>
    <entry name="tilingBorderColorSourceInactive" key="TilingBorderColorSourceInactive" type="Enum">
      <label>Source for the inactive border color</label>
      <choices>
        <choice name="Custom"/>
        <choice name="SystemAccent"/>
        <choice name="SystemAccentFaded"/>
      </choices>
      <default>SystemAccentFaded</default>
    </entry>
    <entry name="tilingBorderColorActive" key="TilingBorderColorActive" type="Color">
      <label>Color of the border around the active tiled window</label>
      <default code="true">QColor(61, 174, 230)</default>
    </entry>
    <entry name="tilingBorderColorInactive" key="TilingBorderColorInactive" type="Color">
      <label>Color of the border around inactive tiled windows</label>
      <default code="true">QColor(128, 128, 128, 200)</default>
    </entry>
    <entry name="tilingCornerRadius" key="TilingCornerRadius" type="Int">
      <label>Corner radius applied to tiled windows (in pixels)</label>
      <default>0</default>
      <min>0</min>
      <max>50</max>
    </entry>
    <entry name="tilingShadowMode" key="TilingShadowMode" type="Enum">
      <label>Shadow display mode for windows</label>
      <choices>
        <choice name="None"/>
        <choice name="AllTiled"/>
        <choice name="ActiveOnly"/>
        <choice name="AllWindows"/>
      </choices>
      <default>None</default>
    </entry>
    <entry name="tilingShadowSize" key="TilingShadowSize" type="Int">
      <label>Blur radius of the tiling shadow (in pixels)</label>
      <default>16</default>
      <min>0</min>
      <max>64</max>
    </entry>
    <entry name="tilingShadowColor" key="TilingShadowColor" type="Color">
      <label>Color of the shadow drawn around tiled windows</label>
      <default code="true">QColor(0, 0, 0, 120)</default>
    </entry>
    <entry name="tilingShadowOffsetX" key="TilingShadowOffsetX" type="Int">
      <label>Horizontal offset of the tiling shadow (in pixels, negative shifts left)</label>
      <default>0</default>
      <min>-32</min>
      <max>32</max>
    </entry>
    <entry name="tilingShadowOpacity" key="TilingShadowOpacity" type="Int">
      <label>Opacity of the tiling shadow (percent, multiplies the color's alpha)</label>
      <default>100</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="tilingShadowOffsetY" key="TilingShadowOffsetY" type="Int">
      <label>Vertical offset of the tiling shadow (in pixels)</label>
      <default>4</default>
      <min>0</min>
      <max>32</max>
    </entry>
    <entry name="resizeStep" key="ResizeStep" type="Double">
      <label>How much each Grow/Shrink shortcut press changes a tiled window's share of its column, or the column divider in a master/stack layout. Expressed in weight units (0.01 - 1.0). The KDE standard 0.05 means a single press moves the divider by 5% of the screen width, or grows a leaf's share by ~5% of its column.</label>
      <default>0.05</default>
      <min>0.01</min>
      <max>1.0</max>
    </entry>
    <entry name="columnsMaxColumns" key="ColumnsMaxColumns" type="Int">
      <label>Maximum number of columns the Columns layout will create. Once this many columns exist, additional windows stack vertically within a column instead. Lowering this below the current column count does not merge existing columns; it only limits further growth.</label>
      <default>3</default>
      <min>3</min>
      <max>5</max>
    </entry>
    <entry name="emergeAxis" key="EmergeAxis" type="Enum">
      <label>Direction the Emerge strip runs. Auto picks horizontal on a landscape output and vertical on a portrait one.</label>
      <choices>
        <choice name="Auto"/>
        <choice name="Horizontal"/>
        <choice name="Vertical"/>
      </choices>
      <default>Auto</default>
    </entry>
    <entry name="emergePresetColumnWidths" key="EmergePresetColumnWidths" type="StringList">
      <label>Column-width presets cycled through by the Emerge layout, as fractions of the work area (0-1).</label>
      <default code="true">QStringList{QStringLiteral("0.333"), QStringLiteral("0.5"), QStringLiteral("0.667"), QStringLiteral("0.75"), QStringLiteral("1")}</default>
    </entry>
    <entry name="emergePresetWindowHeights" key="EmergePresetWindowHeights" type="StringList">
      <label>Stacked-tile height presets used by the Emerge layout, as fractions of the work area (0-1).</label>
      <default code="true">QStringList{QStringLiteral("0.333"), QStringLiteral("0.5"), QStringLiteral("0.667"), QStringLiteral("0.75"), QStringLiteral("1")}</default>
    </entry>
    <entry name="emergePeek" key="EmergePeek" type="Bool">
      <label>Show a peek band at the bottom for Emerge columns scrolled off the strip instead of hiding them completely. Suppressed automatically when a monitor sits directly below the output.</label>
      <default>false</default>
    </entry>
    <entry name="emergePeekHeight" key="EmergePeekHeight" type="Int">
      <label>Height in pixels of the Emerge bottom peek band.</label>
      <default>48</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <entry name="emergeAppWidths" key="EmergeAppWidths" type="StringList">
      <label>Per-app Emerge column widths as windowClass=fraction entries (for example firefox=0.5). The window class is matched exactly and case-insensitively.</label>
    </entry>
  </group>
  <group name="TilingRules">
    <entry name="floatingClasses" key="FloatingClass" type="StringList">
      <label>Window classes that should float by default</label>
    </entry>
    <entry name="ignoreClasses" key="IgnoreClass" type="StringList">
      <label>Window classes that should be ignored by tiling</label>
    </entry>
    <entry name="floatUtility" key="FloatUtility" type="Bool">
      <label>Whether utility windows should float</label>
      <default>true</default>
    </entry>
    <entry name="floatDialog" key="FloatDialog" type="Bool">
      <label>Whether dialog windows should float</label>
      <default>true</default>
    </entry>
    <entry name="floatTransient" key="FloatTransient" type="Bool">
      <label>Whether transient windows should float</label>
      <default>true</default>
    </entry>
  </group>
</kcfg>
